[client]
port=3306
default-character-set = utf8mb4

[mysqld]
port=3306
character-set-server = utf8mb4
skip-character-set-client-handshake
skip-name-resolve
lower_case_table_names = 1
default-storage-engine = InnoDB
innodb_file_per_table = 1
innodb_log_file_size = 512M
max_connections = 300
max_allowed_packet = 256M

# ============================================================
# SBDT: KONFIGURASI SLAVE 1 (Database Cabang 1)
# ============================================================
# Server ID unik untuk Slave 1 — WAJIB berbeda dari Master (1) dan Slave 2 (3)
server_id = 2
# Aktifkan relay log: tempat Slave menyimpan data kiriman dari Master
# sebelum dieksekusi ke database lokal Slave
relay_log = mysql-relay-bin
log_bin = mysql-bin
binlog_format = ROW
# Slave hanya menerima, tidak boleh menerima write langsung dari luar
read_only = 1
# Nama database yang akan direplikasi
replicate_do_db = laravel
expire_logs_days = 7
